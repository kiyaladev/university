  commentaire  String?

  @@index([courrierId, ordre])
}

// ------------------ Anti-Fantômes & Contrôle d'Accès Examens ----------

enum TypeExamen {
  PARTIEL
  FINAL
  RATTRAPAGE
  CONTROLE_CONTINU
}

enum StatutExamen {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}

model Examen {
  id            String          @id @default(uuid())
  intitule      String
  type          TypeExamen      @default(FINAL)
  matiereId     String
  matiere       Matiere         @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  promotionId   String
  promotion     Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  anneeId       String
  annee         AnneeAcademique @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  dateExamen    DateTime
  heureDebut    String
  heureFin      String
  salleId       String?
  salle         Salle?          @relation(fields: [salleId], references: [id], onDelete: SetNull)
  nbInscrits    Int             @default(0)
  nbPresents    Int             @default(0)
  // Identifiant unique de session pour empêcher les substitutions
  codeExamen    String          @unique // "EXAM-2026-0001"
  statut        StatutExamen    @default(PLANIFIE)
  creeParId     String?
  creePar       User?           @relation("ExamenCreePar", fields: [creeParId], references: [id], onDelete: SetNull)
  surveillantId String?
  surveillant   User?           @relation("ExamenSurveillant", fields: [surveillantId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  scans ScanExamen[]

  tirages Tirage[]

  @@index([dateExamen])
  @@index([promotionId])
}

/// Scan de la carte étudiante à l'entrée de la salle d'examen.
model ScanExamen {
  id             String       @id @default(uuid())
  examenId       String
  examen         Examen       @relation(fields: [examenId], references: [id], onDelete: Cascade)
  // Identifiant porteur : étudiant (via son inscription) ou un agent
  inscriptionId  String?
  inscription    Inscription? @relation(fields: [inscriptionId], references: [id], onDelete: SetNull)
  matriculeSaisi String? // fallback si QR ne marche pas
  nomPorteur     String? // capture au scan
  prenomPorteur  String?
  heureScan      DateTime     @default(now())
  // Le scan est validé (porteur légitime) ou rejeté (substitution)
  valide         Boolean      @default(true)
  motifRejet     String? // "carte autre", "photo non reconnue", "introuvable"
  scanneurId     String?
  scanneur       User?        @relation("ScanExamenOperateur", fields: [scanneurId], references: [id], onDelete: SetNull)
  ipAppareil     String?

  @@index([examenId, heureScan])
}

