  clicheLe               DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([statut])
}

// ---------------------------------------------------------------------------
// 7. Hub de formation continue & certifications (recettes propres)
// ---------------------------------------------------------------------------

model Formation {
  id          String          @id @default(uuid())
  titre       String
  description String?
  categorie   String? // "Informatique", "Gestion"…
  prix        Float           @default(0)
  devise      String          @default("GNF")
  dureeHeures Int?
  dateDebut   DateTime?       @db.Date
  dateFin     DateTime?       @db.Date
  lieu        String?
  capacite    Int?
