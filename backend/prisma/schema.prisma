  code               String                 @unique
  libelle            String
  dureeAmortissement Int? // mois
  actif              Boolean                @default(true)
  equipements        EquipementPatrimoine[]
}

/// Équipement physique inventorié (le Helpdesk utilise déjà `EquipementCampus`
/// pour les QR de signalement ; ce modèle est distinct pour l'inventaire MESRS).
model EquipementPatrimoine {
  id                String              @id @default(uuid())
