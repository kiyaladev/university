# Base de données PostgreSQL
DATABASE_URL="postgresql://university:university_pwd@127.0.0.1:5432/university?schema=public"

# Copie distante facultative des sauvegardes (rsync/SSH).
# Exemple : utilisateur@serveur:/srv/backups/university ; clé SSH requise pour le cron.
UNIVERSITY_BACKUP_REMOTE=""

# API
PORT=5031
# Interface d'écoute (défaut 0.0.0.0, toutes les interfaces).
# En production derrière nginx : HOST=127.0.0.1, pour que le port ne soit
# joignable que par le proxy local, jamais directement depuis Internet.
# Aussi utile pour une recette locale isolée.
HOST=0.0.0.0
NODE_ENV=development

# Sécurité
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS="http://localhost:5029,http://127.0.0.1:5029"


# Secret partagé avec la passerelle biométrique (dossier biometrie/) : il doit
# être identique des deux côtés, sinon les lectures d'empreinte sont rejetées.
BIOMETRIE_SECRET="change-me-biometrie"

# Chiffrement des gabarits biométriques au repos : openssl rand -hex 32
# Perdre cette clé rend les empreintes enrôlées irrécupérables (les enseignants
# devront être réenrôlés). À sauvegarder ailleurs que dans la base.
BIOMETRIE_CHIFFREMENT_CLE=""
# Effacement automatique du gabarit après N jours de fiche désactivée.
BIOMETRIE_CONSERVATION_JOURS=90

# Connexion : verrouillage temporaire du compte après échecs répétés.
AUTH_ECHECS_MAX=10
AUTH_VERROU_MINUTES=15

# URL publique de l'application (sans « / » final) : base des liens et des QR
# codes imprimés (attestations, cartes, documents A4). Vide : déduite de
# l'origine de la requête, ce qui ne convient pas pour les documents imprimés.
URL_APPLICATION="https://university.naimba.com"

# Passerelle SMS locale pour les codes OTP du portail. Défaut si absente :
# http://127.0.0.1:5027.
OTP_GATEWAY_URL="http://127.0.0.1:5027"
OTP_API_KEY="changez-moi"
# Gabarit facultatif du SMS ; la passerelle y remplace {code}. Vide : gabarit
# par défaut de la passerelle.
OTP_MESSAGE_TEMPLATE="Votre code University : {code}"

# Opérateur Mobile Money (paiements des inscriptions et des documents).
# Laisser MOBILE_MONEY_URL vide pour rester en simulation : le paiement se
# confirme alors au guichet.
MOBILE_MONEY_URL=""
MOBILE_MONEY_API_KEY="changez-moi"
