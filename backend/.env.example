# Base de données PostgreSQL
DATABASE_URL="postgresql://unipresence:unipresence_pwd@127.0.0.1:5432/unipresence?schema=public"

# API
PORT=5031
NODE_ENV=development

# Sécurité
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS="http://localhost:5029,http://127.0.0.1:5029"


# Secret partagé avec la passerelle biométrique (dossier biometrie/) : il doit
# être identique des deux côtés, sinon les lectures d'empreinte sont rejetées.
BIOMETRIE_SECRET="change-me-biometrie"

# Chiffrement des gabarits biométriques au repos : openssl rand -hex 32
# Perdre cette clé rend les empreintes enrôlées irrécupérables (les enseignants
# devront être réenrôlés). À sauvegarder ailleurs que dans la base.
BIOMETRIE_CHIFFREMENT_CLE=""
# Effacement automatique du gabarit après N jours de fiche désactivée.
BIOMETRIE_CONSERVATION_JOURS=90

# Connexion : verrouillage temporaire du compte après échecs répétés.
AUTH_ECHECS_MAX=10
AUTH_VERROU_MINUTES=15
