{
  "name": "university-api",
  "version": "1.0.0",
  "private": true,
  "description": "University API — contrôle numérique de présence des enseignants (NestJS + Prisma)",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "typecheck:seed": "tsc --noEmit -p tsconfig.seed.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{cjs,ts}\" \"prisma/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.{cjs,ts}\" \"prisma/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "audit:routes": "node scripts/inventaire-routes.cjs /tmp/university-inventaire-routes.json",
    "audit:routes:suivi": "node scripts/inventaire-routes.cjs",
    "test:qa:modules-pilotes": "node scripts/recette-modules-pilotes.cjs",
    "test:qa:restaurant": "node scripts/recette-restaurant.cjs",
    "test:qa:vod": "node scripts/recette-vod.cjs",
    "test:qa:formations": "node scripts/recette-formations.cjs",
    "test:qa:examens-tirage": "node scripts/recette-examens-tirage.cjs",
    "test:qa:rectorat": "node scripts/recette-rectorat.cjs",
    "test:qa:validite-identite": "node scripts/recette-validite-identite.cjs",
    "test:qa:rattachement-attestations": "node scripts/recette-rattachement-attestations.cjs",
    "test:qa:session": "node scripts/session-qa.cjs",
    "test:qa:regie": "node scripts/recette-regie.cjs",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:qa:courrier-departements": "node scripts/recette-courrier-departements.cjs",
    "test:qa:justificatifs": "node scripts/recette-justificatifs.cjs",
    "test:qa:rattrapage": "node scripts/recette-rattrapage.cjs",
    "test:qa:elections": "node scripts/recette-elections.cjs",
    "test:qa:helpdesk-concurrence": "node scripts/recette-helpdesk-concurrence.cjs",
    "test:qa:planning": "node scripts/recette-planning.cjs",
    "test:qa:salles-qr": "node scripts/recette-salles-qr.cjs",
    "test:qa:imports": "node scripts/recette-imports.cjs",
    "test:qa:imports-creneaux": "node scripts/recette-imports-creneaux.cjs",
    "test:qa:releve-pdf": "node scripts/recette-releve-pdf.cjs",
    "test:qa:tournees-couverture": "node scripts/recette-tournees-couverture.cjs",
    "test:qa:journal-integrite": "node scripts/verifier-journal-recettes.cjs",
    "test:qa:paie": "node scripts/recette-paie.cjs"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "nestjs-i18n": "^10.8.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "0.19.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "fast-uri": "3.1.8",
    "deepmerge-ts": "8.0.2",
    "minimatch@3.1.5>brace-expansion": "1.1.21",
    "minimatch@9.0.9>brace-expansion": "2.1.7",
    "minimatch@10.2.6>brace-expansion": "5.0.12",
    "@istanbuljs/load-nyc-config@1.1.0>js-yaml": "3.15.2",
    "cosmiconfig@8.3.6>js-yaml": "4.3.2",
    "@nestjs/swagger@11.4.7>js-yaml": "5.4.2",
    "nestjs-i18n>chokidar": "4.0.3"
  }
}
