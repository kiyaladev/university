node_modules/
dist/
# Copies de retour arrière laissées après une publication (dist.avant-lot7…).
dist.avant-*/
pwa.avant-*/
.quasar/
*.log

# Worktrees d'agents (le dossier .claude/ du checkout de production en
# contient) : jamais versionnés.
.claude/
.env
.env.local
coverage/
.DS_Store
frontend/dist-qa/
frontend/quasar.config.ts.temporary.compiled.*.mjs

# Android / Capacitor
frontend/src-capacitor/www/
frontend/src-capacitor/android/.gradle/
frontend/src-capacitor/android/build/
frontend/src-capacitor/android/app/build/
frontend/src-capacitor/android/local.properties
frontend/src-capacitor/android/capacitor-cordova-android-plugins/
frontend/src-capacitor/android/app/src/main/assets/public/
frontend/src-capacitor/android/app/libs/*.aar

# Clé de signature de l'APK et APK publié : ne doivent jamais être versionnés.
# Perdre la clé interdit toute mise à jour de l'application installée.
android-cle/
telechargement/

# Sauvegardes de la base
backups

# Captures d'écran et journaux des recettes : archivés hors dépôt
# (/var/backups/university/audit-archive-AAAAMMJJ.tar.gz, voir docs/audits/README.md).
# Les *.log sont ignorés par la règle globale ci-dessus.
docs/audits/**/*.png
audit/**/*.png
